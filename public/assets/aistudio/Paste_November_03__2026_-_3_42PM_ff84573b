<!-- BEGIN: ScriptInteractions -->
<script data-purpose="app-interactivity">
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize Lucide icons
      lucide.createIcons();

      // Camera Pause / Resume toggle simulation
      const cameraBtn = document.getElementById('cameraToggleBtn');
      const cameraLabel = document.getElementById('cameraToggleLabel');
      const statusText = document.getElementById('scannerStatusText');
      const laserSweep = document.getElementById('scanLaserSweep');
      let isCameraActive = true;

      cameraBtn.addEventListener('click', () => {
        isCameraActive = !isCameraActive;
        if (isCameraActive) {
          cameraLabel.textContent = 'Pause Camera';
          statusText.textContent = 'ACTIVE';
          statusText.className = 'text-[10px] font-mono uppercase text-emerald-400 font-semibold tracking-wider';
          laserSweep.style.display = 'block';
          cameraBtn.classList.remove('bg-emerald-600');
          cameraBtn.classList.add('bg-royal-600');
        } else {
          cameraLabel.textContent = 'Start Camera';
          statusText.textContent = 'PAUSED';
          statusText.className = 'text-[10px] font-mono uppercase text-amber-400 font-semibold tracking-wider';
          laserSweep.style.display = 'none';
          cameraBtn.classList.remove('bg-royal-600');
          cameraBtn.classList.add('bg-emerald-600');
        }
      });

      // Scan Type Selection Modal Elements
      const modal = document.getElementById('scanTypeModal');
      const quickTypeBtn = document.getElementById('quickTypeSwitchBtn');
      const modalConfirmBtn = document.getElementById('modalConfirmBtn');
      const optBarcode = document.getElementById('modalOptBarcode');
      const optQR = document.getElementById('modalOptQR');

      const btnBarcode = document.getElementById('btnFormatBarcode');
      const btnQR = document.getElementById('btnFormatQR');

      let selectedType = 'BARCODE';

      function openModal() {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.firstElementChild.classList.remove('scale-95');
        modal.firstElementChild.classList.add('scale-100');
      }

      function closeModal() {
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.firstElementChild.classList.remove('scale-100');
        modal.firstElementChild.classList.add('scale-95');
      }

      quickTypeBtn.addEventListener('click', openModal);
      modalConfirmBtn.addEventListener('click', closeModal);

      // Modal options selection logic
      optBarcode.addEventListener('click', () => {
        selectedType = 'BARCODE';
        optBarcode.className = 'p-3.5 rounded-2xl border-2 border-royal-600 bg-blue-50/50 flex flex-col items-center justify-center cursor-pointer transition shadow-sm';
        optQR.className = 'p-3.5 rounded-2xl border-2 border-slate-200 bg-white hover:border-slate-300 flex flex-col items-center justify-center cursor-pointer transition';
        applyFormatSelection('BARCODE');
      });

      optQR.addEventListener('click', () => {
        selectedType = 'QR';
        optQR.className = 'p-3.5 rounded-2xl border-2 border-royal-600 bg-blue-50/50 flex flex-col items-center justify-center cursor-pointer transition shadow-sm';
        optBarcode.className = 'p-3.5 rounded-2xl border-2 border-slate-200 bg-white hover:border-slate-300 flex flex-col items-center justify-center cursor-pointer transition';
        applyFormatSelection('QR');
      });

      function applyFormatSelection(type) {
        if (type === 'BARCODE') {
          btnBarcode.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm bg-royal-700 text-white shadow-glow-blue scale-[1.02]';
          btnQR.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition-all';
        } else {
          btnQR.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm bg-royal-700 text-white shadow-glow-blue scale-[1.02]';
          btnBarcode.className = 'flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition-all';
        }
      }

      btnBarcode.addEventListener('click', () => applyFormatSelection('BARCODE'));
      btnQR.addEventListener('click', () => applyFormatSelection('QR'));

      // Quick Torch Toggle Animation
      const torchBtn = document.getElementById('torchToggle');
      let torchOn = false;
      torchBtn.addEventListener('click', () => {
        torchOn = !torchOn;
        if (torchOn) {
          torchBtn.classList.add('bg-yellow-400', 'text-slate-950', 'shadow-[0_0_12px_#FACC15]');
          torchBtn.classList.remove('bg-slate-900/80', 'text-yellow-400');
        } else {
          torchBtn.classList.remove('bg-yellow-400', 'text-slate-950', 'shadow-[0_0_12px_#FACC15]');
          torchBtn.classList.add('bg-slate-900/80', 'text-yellow-400');
        }
      });

      // Quick filter list simulation
      const searchInput = document.getElementById('memberSearchInput');
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const items = document.querySelectorAll('#membersContainer > div');
        items.forEach(item => {
          const text = item.innerText.toLowerCase();
          item.style.display = text.includes(query) ? 'flex' : 'none';
        });
      });

      // Add new member manually function
      window.addNewManualMember = function() {
        const input = document.getElementById('memberIdInput');
        const value = input.value.trim().toUpperCase();
        if (!value) return;

        const container = document.getElementById('membersContainer');
        const now = new Date();
        const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        const newItem = document.createElement('div');
        newItem.className = 'p-2.5 rounded-xl border border-emerald-300 bg-emerald-50/40 transition-all flex items-center justify-between shadow-sm animate-pulse-ring';
        newItem.innerHTML = `
          <div>
            <h4 class="font-extrabold text-xs text-slate-900 font-mono tracking-wide">${value}</h4>
            <p class="text-[11px] font-mono text-slate-500 mt-0.5">
              Barcode: <span class="text-slate-700">0020-${value}</span>
            </p>
            <p class="text-[10px] text-slate-400 font-medium">
              By: <strong class="text-slate-600">7</strong> &bull; ${timeStr} (Manual)
            </p>
          </div>
          <div class="flex items-center gap-1.5 bg-emerald-500 text-white px-2.5 py-1 rounded-full text-[11px] font-bold shadow-glow-emerald">
            <svg class="w-3.5 h-3.5 stroke-[3]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            <span>INWARDED</span>
          </div>
        `;

        container.prepend(newItem);
        input.value = '';
        setTimeout(() => newItem.classList.remove('animate-pulse-ring'), 2000);
      };
    });
  </script>
<!-- END: ScriptInteractions -->


</body></html>